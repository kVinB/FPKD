{
  "name": "fpkd-seizure-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private family seizure diary (Seizure Diary / FPKD)",
  "engines": {
    "node": ">=20.10 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/src/index.ts server/src/cli.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server --outbase=server/src --sourcemap",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "db:migrate": "tsx server/src/cli.ts migrate",
    "db:bootstrap-admin": "tsx server/src/cli.ts bootstrap-admin",
    "db:reset-password": "tsx server/src/cli.ts reset-password",
    "db:backup": "tsx server/src/cli.ts backup"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/rate-limit": "10.2.2",
    "@fastify/static": "8.0.4",
    "@js-temporal/polyfill": "0.5.1",
    "@react-pdf/renderer": "3.4.4",
    "argon2": "0.41.1",
    "better-sqlite3": "11.10.0",
    "dotenv": "16.4.7",
    "fastify": "5.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.50.1",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.13.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.23.0",
    "@typescript-eslint/parser": "8.23.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.2",
    "esbuild": "0.24.2",
    "eslint": "9.20.0",
    "globals": "15.14.0",
    "jsdom": "26.0.0",
    "pdf-parse": "^1.1.1",
    "postcss": "8.5.1",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.23.0",
    "vite": "6.1.0",
    "vitest": "3.0.5"
  }
}
