# Installed by deploy/proxmox/install-guest.sh. Edit, then restart the service.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
SEIZURE_DIARY_DB_PATH=/var/lib/seizure-diary/seizure-diary.sqlite3
PUBLIC_ORIGIN=https://diary.home.arpa
TRUSTED_PROXIES=127.0.0.1,::1
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
TEMP_SESSION_SECONDS=900
TEMP_PASSWORD_SECONDS=172800
REAUTH_WINDOW_SECONDS=300
SECURE_COOKIES=true
CSRF_SECRET=REPLACED_BY_INSTALLER
BACKUP_DIR=/var/backups/seizure-diary
# BACKUP_ENCRYPTION_KEY=base64-32-bytes-required-for-encrypted-backups-and-updates
