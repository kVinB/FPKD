# Seizure Diary configuration sample. Contains no secrets.
# Copy to .env (development) or /etc/seizure-diary/seizure-diary.env (native install).

# Node environment: development | production | test
NODE_ENV=development

# Listening socket. Bind to loopback and front it with the private HTTPS proxy.
HOST=127.0.0.1
PORT=3000

# Absolute path to the SQLite database on guest-local disk.
SEIZURE_DIARY_DB_PATH=/data/seizure-diary.sqlite3

# Public origin used for exact same-origin checks (no trailing slash).
# Must match the HTTPS host the browser uses, e.g. https://diary.home.arpa
PUBLIC_ORIGIN=https://diary.home.arpa

# Comma-separated extra trusted proxy addresses (only these may set forwarded headers).
TRUSTED_PROXIES=127.0.0.1,::1

# Session lifetimes in seconds. Defaults: 30 min idle, 12 h absolute.
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200

# Restricted first-login (temporary password) session lifetime in seconds.
TEMP_SESSION_SECONDS=900

# Temporary password validity in seconds (default 48 hours).
TEMP_PASSWORD_SECONDS=172800

# Recent re-authentication window for privileged admin resets, in seconds.
REAUTH_WINDOW_SECONDS=300

# Set true only behind a TLS-terminating proxy so cookies gain the Secure flag.
SECURE_COOKIES=true

# Optional: directory of static web build (defaults to dist/web next to the server).
# WEB_DIST=/opt/seizure-diary/current/dist/web

# Operator backup output directory (guest-local or mounted encrypted volume).
BACKUP_DIR=/var/backups/seizure-diary

# Random secret used to sign login CSRF tokens. Required in production.
# Generate with: openssl rand -base64 32
CSRF_SECRET=replace-with-a-long-random-value

# Required for encrypted operator backups and for updates.
# Generate with: openssl rand -base64 32
# BACKUP_ENCRYPTION_KEY=
